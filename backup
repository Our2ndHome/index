<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Musikhjälpen Multi-Widget Overlay</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #ace600; /* Lime Green */
      --secondary-color: #00ff88;
      --giveaway-color: #ffea00;
      --text-white: #ffffff;
      --bg-dark: rgba(0, 0, 0, 0.92);
      --shadow-dark: rgba(0, 0, 0, 0.9);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: transparent;
      font-family: 'Montserrat', Arial, sans-serif;
      height: 100vh;
      overflow: hidden;
      color: var(--text-white);
    }

    /* 🎛️ DRAGGABLE TEST CONTROL PANEL */
    .test-panel {
      position: absolute;
      top: 15px;
      left: 15px;
      background: var(--bg-dark);
      border: 2px solid var(--secondary-color);
      padding: 12px;
      border-radius: 10px;
      color: var(--text-white);
      z-index: 999999;
      max-width: 360px;
      font-size: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    }

    .test-panel h4 {
      margin: 0 0 8px 0;
      font-size: 13px;
      color: var(--secondary-color);
      text-transform: uppercase;
      cursor: move;
      user-select: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 255, 136, 0.1);
      padding: 5px 8px;
      border-radius: 5px;
      border: 1px dashed rgba(0, 255, 136, 0.4);
    }

    .test-panel button {
      background: #222;
      color: var(--text-white);
      border: 1px solid var(--secondary-color);
      padding: 5px 8px;
      margin: 2px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 11px;
      font-weight: bold;
    }

    .test-panel button:hover {
      background: var(--secondary-color);
      color: black;
    }

    .panel-section {
      margin-top: 8px;
      border-top: 1px solid #444;
      padding-top: 6px;
    }

    .sound-status {
      margin-top: 8px;
      font-size: 10px;
      color: #aaa;
    }

    /* ⏱️ WIDGET 1: COMPACT COUNTDOWN TIMER */
    .countdown-widget {
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      white-space: nowrap;
      pointer-events: none;
      transition: all 0.5s ease-in-out;
      z-index: 1000;
    }

    .countdown-label {
      font-size: 12px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--primary-color); 
      text-transform: uppercase;
      margin-bottom: 12px;
      text-shadow: 0 2px 5px var(--shadow-dark);
      transition: all 0.5s ease-in-out;
    }

    .countdown-timer {
      font-size: 34px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: 1px;
      color: var(--text-white); 
      font-variant-numeric: tabular-nums;
      text-shadow: 0 2px 8px var(--shadow-dark);
      transition: all 0.5s ease-in-out;
    }

    .sep-dot {
      color: var(--primary-color);
      margin: 0 3px;
    }

    /* 🔥 FINAL 60 SECONDS DRAMATIC STATE */
    .countdown-widget.final-minute .countdown-label {
      font-size: 16px;
      color: var(--primary-color);
      letter-spacing: 3px;
      margin-bottom: 12px;
      text-shadow: 0 0 15px rgba(172, 230, 0, 0.8);
      animation: finalSecondPulse 1s infinite alternate;
    }

    .countdown-widget.final-minute .countdown-timer {
      font-size: 48px;
      color: var(--text-white);
      text-shadow: 0 0 15px var(--shadow-dark), 0 0 25px rgba(255, 255, 255, 0.9);
    }

    @keyframes finalSecondPulse {
      0% { transform: scale(1); }
      100% { transform: scale(1.08); }
    }

    /* Timer Finished State */
    .timer-finished .countdown-label {
      color: var(--primary-color);
      font-size: 24px;
      animation: pulseGlow 1.5s infinite alternate;
    }

    .timer-finished .countdown-timer {
      display: none !important;
    }

    @keyframes pulseGlow {
      0% { text-shadow: 0 0 10px rgba(172, 230, 0, 0.5); }
      100% { text-shadow: 0 0 25px rgba(172, 230, 0, 1); }
    }

    /* 💰 WIDGET 3: TOTAL RAISED GOAL COUNTER */
    .goal-widget {
      position: absolute;
      top: 88px; 
      left: 50%;
      transform: translateX(-50%);
      background: transparent;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 1px;
      white-space: nowrap;
      z-index: 1000;
      font-size: 22px;
      font-weight: 900;
      color: var(--text-white);
      text-shadow: 0 2px 10px var(--shadow-dark);
      transition: top 0.5s ease-in-out, opacity 0.4s ease-in-out;
    }

    body.is-final-minute .goal-widget {
      top: 106px;
    }

    .goal-label {
      font-size: 12px;
      line-height: 1;
      color: var(--text-white);
      display: block;
      margin-bottom: 8px;
      letter-spacing: 1.5px;
      text-shadow: 0 2px 5px var(--shadow-dark);
    }

    .amount {
      color: var(--primary-color);
      font-size: 34px;
      line-height: 1;
      font-weight: 900;
      text-shadow: 0 0 15px rgba(172, 230, 0, 0.5);
      transition: opacity 0.4s ease-in-out;
      display: block;
    }

    .goal-target {
      font-size: 11px;
      font-weight: 800;
      color: var(--text-white);
      display: block;
      margin-top: 8px;
      letter-spacing: 1.2px;
      opacity: 0.9;
      text-shadow: 0 2px 5px var(--shadow-dark);
    }

    /* 📢 WIDGET 2: DONATION ALERT BANNER */
    .alert-banner {
      position: absolute;
      top: 42%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0;
      visibility: hidden;
      text-align: center;
      background: transparent;
      padding: 10px;
      text-transform: uppercase;
      white-space: nowrap;
      pointer-events: none;
      z-index: 99999;
      transition: opacity 0.4s ease, visibility 0.4s ease;
      text-shadow: 0 3px 15px var(--shadow-dark);
    }

    .donor-name {
      color: var(--primary-color);
      display: block;
      font-size: 56px;
      font-weight: 900;
      margin-bottom: 5px;
      text-shadow: 0 0 12px rgba(172, 230, 0, 0.5);
    }

    .alert-subtext {
      color: var(--text-white);
      font-size: 38px;
      font-weight: 900;
    }

    .show-alert {
      opacity: 1 !important;
      visibility: visible !important;
      animation: elasticPop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes elasticPop {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.3); }
      60% { opacity: 1; transform: translate(-50%, -50%) scale(1.3); }
      100% { opacity: 1; transform: translate(-50%, -50%) scale(1.0); }
    }

    /* 🖼️ WIDGET 4: SPONSORSHIP LOGO ROTATOR */
    .sponsor-widget {
      position: absolute;
      bottom: 80px;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      z-index: 1000;
      background: transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .sponsor-logo-container {
      width: 140px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .sponsor-logo {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      transition: opacity 0.6s ease-in-out;
      opacity: 1;
      filter: drop-shadow(0 2px 8px var(--shadow-dark));
    }

    .sponsor-label {
      font-size: 11px;
      font-weight: 900;
      color: var(--primary-color);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      display: block;
      margin-top: 4px;
      text-shadow: 0 0 10px var(--shadow-dark);
    }

    /* 📅 WIDGET 5: TIMELINE SCHEDULE BAR */
    .schedule-widget {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      width: 96vw;
      background: transparent;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 1000;
      pointer-events: none;
    }

    .timeline-container {
      position: relative;
      width: 100%;
    }

    .timeline-line-bg {
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 2px;
      background: rgba(255, 255, 255, 0.15);
      transform: translateY(-50%);
      z-index: 1;
    }

    .timeline-line-fill {
      position: absolute;
      top: 50%;
      left: 0;
      height: 3px;
      background: var(--primary-color);
      box-shadow: 0 0 8px rgba(172, 230, 0, 0.6);
      transform: translateY(-50%);
      z-index: 2;
      width: 0%;
      transition: width 0.5s linear;
    }

    .timeline-cursor {
      position: absolute;
      top: 50%;
      left: 0%;
      width: 10px;
      height: 10px;
      background: var(--primary-color);
      box-shadow: 0 0 8px var(--primary-color), 0 0 14px var(--primary-color);
      transform: translate(-50%, -50%);
      z-index: 5;
      border-radius: 50%;
      transition: left 0.5s linear;
    }

    .timeline-nodes-row {
      position: relative;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      z-index: 3;
    }

    .timeline-day-badge {
      background: rgba(172, 230, 0, 0.18);
      border: 1px solid var(--primary-color);
      color: var(--primary-color);
      font-size: 11px;
      font-weight: 900;
      padding: 3px 8px;
      border-radius: 5px;
      letter-spacing: 1px;
      text-transform: uppercase;
      white-space: nowrap;
      box-shadow: 0 0 10px rgba(172, 230, 0, 0.3);
      margin-right: 10px;
      align-self: center;
    }

    /* EVENT NODE SPAN BAR (|────────────────| Layout) */
    .timeline-node {
      display: flex;
      flex-direction: column;
      position: relative;
      flex: 1;
      align-items: center;
      text-align: center;
      padding: 0 4px;
      transition: all 0.3s ease;
      text-shadow: 0 2px 6px var(--shadow-dark);
    }

    .node-time {
      font-size: 11px;
      font-weight: 800;
      color: #e0e0e0;
      letter-spacing: 0.5px;
    }

    .node-segment-bar {
      position: relative;
      width: 100%;
      height: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 3px 0;
    }

    .segment-line {
      position: relative;
      width: 100%;
      height: 2px;
      background: rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease;
    }

    .segment-line::before {
      content: '';
      position: absolute;
      left: 0;
      top: -4px;
      width: 2px;
      height: 10px;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 1px;
      transition: all 0.3s ease;
    }

    .segment-line::after {
      content: '';
      position: absolute;
      right: 0;
      top: -4px;
      width: 2px;
      height: 10px;
      background: rgba(255, 255, 255, 0.5);
      border-radius: 1px;
      transition: all 0.3s ease;
    }

    .node-streamer {
      font-size: 14px;
      font-weight: 900;
      color: var(--text-white);
      white-space: nowrap;
    }

    .node-streamer.is-giveaway-text {
      color: var(--giveaway-color);
    }

    .timeline-node.active .segment-line {
      background: rgba(172, 230, 0, 0.6);
      height: 3px;
      box-shadow: 0 0 8px rgba(172, 230, 0, 0.6);
    }

    .timeline-node.active .segment-line::before,
    .timeline-node.active .segment-line::after {
      background: var(--primary-color);
      height: 14px;
      top: -5px;
      width: 3px;
      box-shadow: 0 0 10px rgba(172, 230, 0, 0.9);
    }

    .timeline-node.active .node-streamer {
      font-size: 17px;
      font-weight: 900;
      color: var(--primary-color);
      text-shadow: 0 0 10px rgba(172, 230, 0, 0.8);
    }

    .timeline-node.active .node-streamer.is-giveaway-text {
      color: var(--giveaway-color);
      font-size: 17px;
      text-shadow: 0 0 12px rgba(255, 234, 0, 0.9);
    }

    .timeline-node.active .node-time {
      color: var(--text-white);
      font-size: 12px;
      font-weight: 900;
    }

    .brb-header {
      position: absolute;
      top: 35%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 64px;
      font-weight: 900;
      color: var(--primary-color);
      text-transform: uppercase;
      text-shadow: 0 0 20px rgba(172, 230, 0, 0.6);
      display: none;
      z-index: 1000;
    }
  </style>
</head>
<body>

  <!-- 🎛️ TEST CONTROL PANEL -->
  <div class="test-panel" id="testPanel">
    <h4 id="panelDragHeader">🧪 TESTPANEL <span style="font-size:10px; opacity:0.8;">✋ DRA FÖR ATT FLYTTA</span></h4>
    <button onclick="simulateDonation('Anna', 50)">+50 kr (Anna)</button>
    <button onclick="simulateDonation('Erik', 200)">+200 kr (Erik)</button>
    <button onclick="simulateDonation('Anonym', 100)">+100 kr (Anonym)</button>
    <button onclick="resetTotal()" style="border-color:#ff0055;">Nollställ</button>

    <div class="panel-section">
      <b>Live Schema Test:</b><br>
      <button onclick="generateRelativeLiveEvents()" style="background:#ace600; color:#000;">⚡ Generera Relativa Events (Nu)</button>
    </div>
    
    <div class="panel-section">
      <b>Timer kontroller:</b><br>
      <button onclick="simulateEndGame()">Sista Minuten (60s)</button>
      <button onclick="resetEventTimer()">Återställ Timer</button>
    </div>

    <div class="panel-section">
      <b>Sponsor kontroller:</b><br>
      <button onclick="nextSponsor()">Nästa Sponsor</button>
    </div>

    <div class="panel-section">
      <b>Rolling Queue Highlighting Test:</b><br>
      <button onclick="testLiveHighlight(0)">Testa Slot 1 (Tidigare Idag)</button>
      <button onclick="testLiveHighlight(2)">Testa Slot 3 (LIVE NU)</button>
      <button onclick="testLiveHighlight(4)">Testa Slot 5 (Skifte Onsdag)</button>
      <button onclick="testLiveHighlight(-1)">Automatisk Klocka</button>
    </div>

    <div class="panel-section">
      <b>Scenläge förhandsgranskning:</b><br>
      <button onclick="applySceneMode('game')">Spel Scen (?scene=game)</button>
      <button onclick="applySceneMode('starting')">Startar Om (?scene=starting)</button>
      <button onclick="applySceneMode('brb')">BRB / Paus (?scene=brb)</button>
      <button onclick="applySceneMode('all')">Visa Alla Widgets</button>
    </div>

    <div class="sound-status" id="soundStatus">Laddar...</div>
  </div>

  <!-- ⏱️ WIDGET 1: COUNTDOWN TIMER -->
  <div class="countdown-widget" id="countdownWidget">
    <div class="countdown-label" id="countdownLabel">INSAMLINGEN SLUTAR OM</div>
    <div class="countdown-timer" id="countdownTimer">0D • 00:00:00</div>
  </div>

  <!-- 💰 WIDGET 3: GOAL COUNTER -->
  <div class="goal-widget" id="goalWidget">
    <span class="goal-label">TOTALT INSAMLAT</span>
    <span class="amount" id="totalDisplay">0 kr</span>
    <span class="goal-target">MÅL: 40 000 KR</span>
  </div>

  <!-- 📢 WIDGET 2: DONATION ALERT -->
  <div class="alert-banner" id="alertBanner">
    <span class="donor-name" id="donorName">JOHAN</span> 
    <div class="alert-subtext">DONERADE <span id="alertAmount">50 kr</span>!</div>
  </div>

  <!-- 🖼️ WIDGET 4: SPONSOR ROTATOR -->
  <div class="sponsor-widget" id="sponsorWidget">
    <div class="sponsor-logo-container">
      <img id="sponsorLogo" class="sponsor-logo" src="" alt="Sponsor Logo" />
    </div>
    <span class="sponsor-label">SPONSORER</span>
  </div>

  <!-- 📅 WIDGET 5: SCHEDULE BAR -->
  <div class="schedule-widget" id="scheduleWidget">
    <div class="timeline-container">
      <div class="timeline-line-bg"></div>
      <div class="timeline-line-fill" id="timelineProgressFill"></div>
      <div class="timeline-cursor" id="timelineCursor"></div>
      
      <div class="timeline-nodes-row" id="scheduleEventsRow"></div>
    </div>
  </div>

  <!-- BRB Header Text -->
  <div class="brb-header" id="brbHeader">STRAX TILLBAKA</div>

  <script>
    // =========================================================
    // CONFIGURATION
    // =========================================================
    const FUNDRAISER_API_URL = "https://musikhjalpen-franceska.herokuapp.com/server/fundraisers/6ScUK7SzaLDgMSesIjAYA8?fields%5B%5D=amount&fields%5B%5D=donations";
    const CHECK_INTERVAL_SECONDS = 5;

    const GITHUB_USERNAME = "Our2ndHome";
    const GITHUB_REPO = "index";
    const SOUNDS_FOLDER = "sounds"; 
    const SPONSORS_FOLDER = "sponsors";
    const SOUND_VOLUME = 0.8;
    const SPONSOR_ROTATE_SECONDS = 15;
    const PAUSE_BETWEEN_ALERTS_SECONDS = 5; 

    // BACKUP SOUNDS
    const TIKTOK_BACKUP_SOUNDS = [
      'sounds/ssstik.io_1786298964532.mp3',
      'sounds/ssstik.io_1786298991426.mp3',
      'sounds/ssstik.io_1786299005161.mp3'
    ];

    // BACKUP SPONSORS
    const DEFAULT_SPONSORS = [
      'https://via.placeholder.com/140x50/111/ace600?text=SPONSOR+A',
      'https://via.placeholder.com/140x50/111/00ff88?text=SPONSOR+B',
      'https://via.placeholder.com/140x50/111/ffea00?text=SPONSOR+C'
    ];

    // 📅 SCHEDULE DATA (Strict Day System)
    let ALL_SCHEDULE_EVENTS = [
      { id: 0, dayName: "TISDAG", start: "2026-08-11T18:00:00", end: "2026-08-11T20:00:00", timeText: "18:00 - 20:00", name: "Alex & Robin", giveaway: "" },
      { id: 1, dayName: "TISDAG", start: "2026-08-11T20:00:00", end: "2026-08-11T22:00:00", timeText: "20:00 - 22:00", name: "GamerGirl99", giveaway: "" },
      // 🔴 ACTIVE EVENT (Current Time is ~22:35 CEST)
      { id: 2, dayName: "TISDAG", start: "2026-08-11T22:00:00", end: "2026-08-11T23:00:00", timeText: "22:00 - 23:00", name: "Live Streamer Now", giveaway: "🎁 LIVE GIVEAWAY!" },
      { id: 3, dayName: "TISDAG", start: "2026-08-11T23:00:00", end: "2026-08-12T01:00:00", timeText: "23:00 - 01:00", name: "Night Shift Crew", giveaway: "" },
      
      // TOMORROW (Midnight Cross triggers [ONSDAG] badge automatically)
      { id: 4, dayName: "ONSDAG", start: "2026-08-12T18:00:00", end: "2026-08-12T20:00:00", timeText: "18:00 - 20:00", name: "Morning Special", giveaway: "" },
      { id: 5, dayName: "ONSDAG", start: "2026-08-12T20:00:00", end: "2026-08-12T22:00:00", timeText: "20:00 - 22:00", name: "Final Boss Stream", giveaway: "🏆 GRAND PRIZE!" }
    ];

    function generateRelativeLiveEvents() {
      const now = new Date();
      const pad = (n) => String(n).padStart(2, '0');
      const dayNames = ["SÖNDAG", "MÅNDAG", "TISDAG", "ONSDAG", "TORSDAG", "FREDAG", "LÖRDAG"];

      const formatISO = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`;
      const formatTime = (d1, d2) => `${pad(d1.getHours())}:${pad(d1.getMinutes())} - ${pad(d2.getHours())}:${pad(d2.getMinutes())}`;

      const t1 = new Date(now.getTime() - 4 * 3600000);
      const t2 = new Date(now.getTime() - 2 * 3600000);
      const t3 = new Date(now.getTime() - 35 * 60000); // Started 35 mins ago
      const t4 = new Date(now.getTime() + 25 * 60000); // Ends in 25 mins
      const t5 = new Date(now.getTime() + 2.5 * 3600000);
      const t6 = new Date(now.getTime() + 24 * 3600000); // Tomorrow (+24 hours)

      ALL_SCHEDULE_EVENTS = [
        { id: 0, dayName: dayNames[t1.getDay()], start: formatISO(t1), end: formatISO(t2), timeText: formatTime(t1, t2), name: "Tidigare Streamer A", giveaway: "" },
        { id: 1, dayName: dayNames[t2.getDay()], start: formatISO(t2), end: formatISO(t3), timeText: formatTime(t2, t3), name: "Tidigare Streamer B", giveaway: "" },
        { id: 2, dayName: dayNames[t3.getDay()], start: formatISO(t3), end: formatISO(t4), timeText: formatTime(t3, t4), name: "LIVE STREAMER NU", giveaway: "🎁 REALTIDS GIVEAWAY!" },
        { id: 3, dayName: dayNames[t4.getDay()], start: formatISO(t4), end: formatISO(t5), timeText: formatTime(t4, t5), name: "Kommande Streamer", giveaway: "" },
        { id: 4, dayName: dayNames[t6.getDay()], start: formatISO(t5), end: formatISO(t6), timeText: formatTime(t5, t6), name: "Morgondagens Event", giveaway: "🏆 NÄSTA DAGS EVENT" }
      ];

      testForcedEventId = -1;
      renderSchedule();
    }

    let soundFileList = TIKTOK_BACKUP_SOUNDS;
    let sponsorFileList = DEFAULT_SPONSORS;
    let availableSoundsPool = []; 
    let currentSponsorIndex = 0;
    let currentTotal = 0; 
    let testForcedEventId = -1; 
    let currentAudioInstance = null;

    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
    }

    // =========================================================
    // 🖐️ DRAGGABLE PANEL ENGINE
    // =========================================================
    function makePanelDraggable() {
      const panel = document.getElementById('testPanel');
      const header = document.getElementById('panelDragHeader');
      if (!panel || !header) return;

      let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
      header.onmousedown = (e) => {
        e.preventDefault();
        pos3 = e.clientX;
        pos4 = e.clientY;
        document.onmouseup = () => { document.onmouseup = null; document.onmousemove = null; };
        document.onmousemove = (ev) => {
          ev.preventDefault();
          pos1 = pos3 - ev.clientX;
          pos2 = pos4 - ev.clientY;
          pos3 = ev.clientX;
          pos4 = ev.clientY;
          panel.style.top = (panel.offsetTop - pos2) + "px";
          panel.style.left = (panel.offsetLeft - pos1) + "px";
        };
      };
    }

    // =========================================================
    // 🎛️ SCENE MODE SWITCHER
    // =========================================================
    function applySceneMode(forcedMode) {
      const urlParams = new URLSearchParams(window.location.search);
      const scene = forcedMode || urlParams.get('scene') || 'all';

      const widgets = {
        countdown: document.getElementById('countdownWidget'),
        schedule: document.getElementById('scheduleWidget'),
        sponsor: document.getElementById('sponsorWidget'),
        goal: document.getElementById('goalWidget'),
        brb: document.getElementById('brbHeader')
      };

      widgets.countdown.style.display = 'block';
      widgets.schedule.style.display = 'flex';
      widgets.sponsor.style.display = 'flex';
      widgets.goal.style.display = 'block';
      widgets.brb.style.display = 'none';

      if (scene === 'game' || scene === 'overlay') {
        widgets.countdown.style.display = 'none';
        widgets.schedule.style.display = 'none';
      } else if (scene === 'brb' || scene === 'paus') {
        widgets.countdown.style.display = 'none';
        widgets.brb.style.display = 'block';
      }
    }

    // =========================================================
    // 📅 SCHEDULE TIMELINE ENGINE
    // =========================================================
    function renderSchedule() {
      const eventsRowEl = document.getElementById('scheduleEventsRow');
      const fillLineEl = document.getElementById('timelineProgressFill');
      const cursorEl = document.getElementById('timelineCursor');
      if (!eventsRowEl) return;

      const now = new Date();
      let activeIndex = 0;

      if (testForcedEventId !== -1) {
        const found = ALL_SCHEDULE_EVENTS.findIndex(ev => ev.id === testForcedEventId);
        if (found !== -1) activeIndex = found;
      } else {
        const found = ALL_SCHEDULE_EVENTS.findIndex(ev => {
          return now >= new Date(ev.start) && now < new Date(ev.end);
        });
        if (found !== -1) {
          activeIndex = found;
        } else {
          const upcoming = ALL_SCHEDULE_EVENTS.findIndex(ev => new Date(ev.start) > now);
          if (upcoming !== -1) activeIndex = upcoming;
        }
      }

      let visibleEvents = ALL_SCHEDULE_EVENTS.slice(activeIndex, activeIndex + 5);
      if (visibleEvents.length < 5 && ALL_SCHEDULE_EVENTS.length >= 5) {
        visibleEvents = ALL_SCHEDULE_EVENTS.slice(ALL_SCHEDULE_EVENTS.length - 5);
      }

      const totalVisible = visibleEvents.length;

      if (totalVisible > 0) {
        let activeLocalIdx = visibleEvents.findIndex(ev => ev.id === (testForcedEventId !== -1 ? testForcedEventId : ALL_SCHEDULE_EVENTS[activeIndex].id));
        if (activeLocalIdx === -1) activeLocalIdx = 0;

        const currentEv = visibleEvents[activeLocalIdx];
        const startMs = new Date(currentEv.start).getTime();
        const endMs = new Date(currentEv.end).getTime();
        const nowMs = now.getTime();

        let currentSlotPct = 0;
        if (testForcedEventId !== -1 || nowMs >= endMs) {
          currentSlotPct = 1.0;
        } else if (nowMs > startMs) {
          currentSlotPct = (nowMs - startMs) / (endMs - startMs);
        }

        const slotWidthPct = 100 / totalVisible;
        const totalProgressPct = Math.min(100, Math.max(0, (activeLocalIdx + currentSlotPct) * slotWidthPct));

        if (fillLineEl) fillLineEl.style.width = `${totalProgressPct}%`;
        if (cursorEl) cursorEl.style.left = `${totalProgressPct}%`;
      }

      const currentActiveDay = visibleEvents[0] ? visibleEvents[0].dayName : "";
      let lastSeenDay = currentActiveDay;

      eventsRowEl.innerHTML = visibleEvents.map((ev) => {
        const isLiveNow = (testForcedEventId === ev.id) || 
                          (testForcedEventId === -1 && now >= new Date(ev.start) && now < new Date(ev.end));

        const hasGiveaway = Boolean(ev.giveaway && ev.giveaway.trim());
        const primaryText = escapeHTML(hasGiveaway ? ev.giveaway : ev.name);
        const streamerClass = hasGiveaway ? "node-streamer is-giveaway-text" : "node-streamer";

        let dayBadgeHtml = "";
        if (ev.dayName !== currentActiveDay && ev.dayName !== lastSeenDay) {
          dayBadgeHtml = `<div class="timeline-day-badge">${escapeHTML(ev.dayName)}</div>`;
          lastSeenDay = ev.dayName;
        }

        return `
          ${dayBadgeHtml}
          <div class="timeline-node ${isLiveNow ? 'active' : 'inactive'}">
            <div class="node-time">${escapeHTML(ev.timeText)}</div>
            <div class="node-segment-bar">
              <div class="segment-line"></div>
            </div>
            <div class="${streamerClass}">${primaryText}</div>
          </div>
        `;
      }).join('');
    }

    function testLiveHighlight(eventId) {
      testForcedEventId = eventId;
      renderSchedule();
    }

    // =========================================================
    // 🖼️ SPONSOR ROTATOR
    // =========================================================
    async function loadSponsorsAutomatically() {
      try {
        const response = await fetch(`https://api.github.com/repos/${GITHUB_USERNAME}/${GITHUB_REPO}/contents/${SPONSORS_FOLDER}`);
        if (response.ok) {
          const files = await response.json();
          const apiSponsors = files
            .filter(f => f.type === 'file' && f.name.match(/\.(png|jpg|jpeg|svg|webp)$/i))
            .map(f => `${SPONSORS_FOLDER}/${encodeURIComponent(f.name)}`);
          if (apiSponsors.length > 0) sponsorFileList = apiSponsors;
        }
      } catch (e) {}

      updateSponsorLogo();
      setInterval(nextSponsor, SPONSOR_ROTATE_SECONDS * 1000);
    }

    function updateSponsorLogo() {
      const img = document.getElementById('sponsorLogo');
      if (!img || sponsorFileList.length === 0) return;
      img.style.opacity = '0';
      setTimeout(() => {
        img.src = sponsorFileList[currentSponsorIndex];
        img.style.opacity = '1';
      }, 600);
    }

    function nextSponsor() {
      if (sponsorFileList.length === 0) return;
      currentSponsorIndex = (currentSponsorIndex + 1) % sponsorFileList.length;
      updateSponsorLogo();
    }

    // =========================================================
    // ⏱️ COUNTDOWN TIMER
    // =========================================================
    let countdownTargetTime = null;

    function getEventTargetDate() {
      return new Date("2026-12-16T23:00:00").getTime();
    }

    function initCountdown() {
      countdownTargetTime = getEventTargetDate();
      updateCountdownDisplay();
      setInterval(updateCountdownDisplay, 1000);
    }

    function updateCountdownDisplay() {
      const widget = document.getElementById('countdownWidget');
      const label = document.getElementById('countdownLabel');
      const timerDisplay = document.getElementById('countdownTimer');
      const diff = countdownTargetTime - Date.now();

      if (diff <= 0) {
        timerDisplay.innerText = "";
        label.innerText = "INSAMLINGEN ÄR AVSLUTAD!";
        widget.classList.remove('final-minute');
        widget.classList.add('timer-finished');
        document.body.classList.remove('is-final-minute');
        return;
      }

      widget.classList.remove('timer-finished');
      const totalSecondsRemaining = Math.floor(diff / 1000);

      if (totalSecondsRemaining <= 60) {
        document.body.classList.add('is-final-minute');
        widget.classList.add('final-minute');
        label.innerText = "SISTA MINUTEN!";
        timerDisplay.innerText = String(totalSecondsRemaining).padStart(2, '0');
        return;
      }

      document.body.classList.remove('is-final-minute');
      widget.classList.remove('final-minute');
      label.innerText = "INSAMLINGEN SLUTAR OM";

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      const hStr = String(hours).padStart(2, '0');
      const mStr = String(minutes).padStart(2, '0');
      const sStr = String(seconds).padStart(2, '0');

      timerDisplay.innerHTML = days > 0 
        ? `${days}D <span class="sep-dot">•</span> ${hStr}:${mStr}:${sStr}`
        : `${hStr}:${mStr}:${sStr}`;
    }

    function simulateEndGame() {
      countdownTargetTime = Date.now() + 60000;
      updateCountdownDisplay();
    }

    function resetEventTimer() {
      countdownTargetTime = getEventTargetDate();
      updateCountdownDisplay();
    }

    // =========================================================
    // 📢 SOUND & ALERT ENGINE
    // =========================================================
    function shuffleArray(array) {
      const arr = [...array];
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function getNextShuffledSound() {
      if (!availableSoundsPool || availableSoundsPool.length === 0) {
        availableSoundsPool = shuffleArray(soundFileList);
      }
      return availableSoundsPool.pop();
    }

    async function loadSoundsAutomatically() {
      const statusElement = document.getElementById('soundStatus');
      let foundSounds = [];

      try {
        const txtRes = await fetch(`sounds/list.txt?_t=${Date.now()}`);
        if (txtRes.ok) {
          const text = await txtRes.text();
          const lines = text.split('\n').map(l => l.trim()).filter(l => l.length > 0 && !l.startsWith('#'));
          if (lines.length > 0) foundSounds = lines.map(file => `sounds/${encodeURIComponent(file)}`);
        }
      } catch (e) {}

      if (foundSounds.length === 0) {
        try {
          const response = await fetch(`https://api.github.com/repos/${GITHUB_USERNAME}/${GITHUB_REPO}/contents/${SOUNDS_FOLDER}`);
          if (response.ok) {
            const files = await response.json();
            const apiSounds = files.filter(f => f.type === 'file' && f.name.match(/\.(mp3|wav|ogg|m4a)$/i))
                                  .map(f => `${SOUNDS_FOLDER}/${encodeURIComponent(f.name)}`);
            if (apiSounds.length > 0) foundSounds = apiSounds;
          }
        } catch (e) {}
      }

      soundFileList = foundSounds.length > 0 ? foundSounds : TIKTOK_BACKUP_SOUNDS;
      if (statusElement) {
        statusElement.innerHTML = `<b>${soundFileList.length} ljud redo!</b>`;
      }
    }

    function playAlertSound() {
      return new Promise((resolve) => {
        let isDone = false;

        if (currentAudioInstance) {
          currentAudioInstance.pause();
          currentAudioInstance = null;
        }

        const finish = () => {
          if (!isDone) {
            isDone = true;
            resolve();
          }
        };

        const hardTimeout = setTimeout(() => {
          if (currentAudioInstance) currentAudioInstance.pause();
          finish();
        }, 4000);

        try {
          if (soundFileList.length > 0) {
            const audio = new Audio(getNextShuffledSound());
            audio.volume = SOUND_VOLUME;
            currentAudioInstance = audio;

            audio.addEventListener('ended', () => { clearTimeout(hardTimeout); finish(); }, { once: true });
            audio.addEventListener('error', () => { clearTimeout(hardTimeout); finish(); }, { once: true });

            audio.play().catch(() => finish());
          } else {
            clearTimeout(hardTimeout);
            setTimeout(finish, 2000);
          }
        } catch (e) {
          clearTimeout(hardTimeout);
          finish();
        }
      });
    }

    // =========================================================
    // ALERT QUEUE SYSTEM
    // =========================================================
    const alertQueue = [];
    let isProcessingAlert = false;

    function enqueueAlert(donorName, diffAmount, newTotal) {
      alertQueue.push({ donorName, diffAmount, newTotal });
      processQueue();
    }

    function updateTotalDisplaySmooth(newTotalText) {
      const display = document.getElementById('totalDisplay');
      if (!display || display.innerText === newTotalText) return;

      display.style.opacity = '0';
      setTimeout(() => {
        display.innerText = newTotalText;
        display.style.opacity = '1';
      }, 400);
    }

    async function processQueue() {
      if (isProcessingAlert || alertQueue.length === 0) return;

      isProcessingAlert = true;
      const nextAlert = alertQueue.shift();

      const banner = document.getElementById('alertBanner');
      document.getElementById('donorName').innerText = nextAlert.donorName;
      document.getElementById('alertAmount').innerText = `${nextAlert.diffAmount} kr`;

      updateTotalDisplaySmooth(`${nextAlert.newTotal} kr`);

      banner.classList.remove('show-alert');
      void banner.offsetWidth;
      banner.classList.add('show-alert');

      await playAlertSound();

      banner.classList.remove('show-alert');

      setTimeout(() => {
        isProcessingAlert = false;
        processQueue();
      }, PAUSE_BETWEEN_ALERTS_SECONDS * 1000);
    }

    // =========================================================
    // MANUAL CONTROLS & API POLLING
    // =========================================================
    function simulateDonation(name, amount) {
      currentTotal += amount;
      enqueueAlert(name, amount, currentTotal);
    }

    function resetTotal() {
      currentTotal = 0;
      alertQueue.length = 0;
      updateTotalDisplaySmooth('0 kr');
    }

    async function fetchMusikhjalpenData() {
      try {
        const response = await fetch(`${FUNDRAISER_API_URL}&_t=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) return;

        const data = await response.json();
        const amount = Number(data.amount || 0);

        let latestDonorName = "En anonym givare"; 
        if (data.donations && data.donations.length > 0) {
          const lastDonation = data.donations[0];
          if (lastDonation.name && lastDonation.name.trim()) {
            latestDonorName = lastDonation.name;
          }
        }

        if (currentTotal === 0 && amount > 0) {
          currentTotal = amount;
          updateTotalDisplaySmooth(`${currentTotal} kr`);
          return;
        }

        if (amount > currentTotal) {
          const donationDiff = amount - currentTotal;
          currentTotal = amount;
          enqueueAlert(latestDonorName, donationDiff, currentTotal);
        }
      } catch (err) {
        console.warn("Connecting to API...", err);
      }
    }

    if (new URLSearchParams(window.location.search).get('live') === '1') {
      document.getElementById('testPanel').style.display = 'none';
    }

    // INITIALIZATION
    makePanelDraggable();
    applySceneMode();
    renderSchedule();
    initCountdown();
    loadSponsorsAutomatically();
    loadSoundsAutomatically();
    fetchMusikhjalpenData();

    setInterval(fetchMusikhjalpenData, CHECK_INTERVAL_SECONDS * 1000);
    setInterval(renderSchedule, 1000);
  </script>
