<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Musikhjälpen Multi-Widget Overlay - Our2ndHome v2.7</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #ace600; /* Lime Green */
      --secondary-color: #00ff88;
      --giveaway-color: #ffea00;
      --text-white: #ffffff;
      --bg-dark: rgba(0, 0, 0, 0.92);
      --shadow-dark: rgba(0, 0, 0, 0.85);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: transparent;
      font-family: 'Montserrat', Arial, sans-serif;
      height: 100vh;
      overflow: hidden;
      color: var(--text-white);
    }

    /* 🎛️ DRAGGABLE TEST CONTROL PANEL WITH VERSION TAG */
    .test-panel {
      position: absolute;
      top: 15px;
      left: 15px;
      background: var(--bg-dark);
      border: 2px solid var(--secondary-color);
      padding: 12px;
      border-radius: 10px;
      color: var(--text-white);
      z-index: 999999;
      max-width: 380px;
      font-size: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    }

    .test-panel h4 {
      margin: 0 0 8px 0;
      font-size: 13px;
      color: var(--secondary-color);
      text-transform: uppercase;
      cursor: move;
      user-select: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(0, 255, 136, 0.1);
      padding: 5px 8px;
      border-radius: 5px;
      border: 1px dashed rgba(0, 255, 136, 0.4);
    }

    .version-badge {
      background: var(--secondary-color);
      color: #000;
      font-size: 9px;
      font-weight: 900;
      padding: 1px 5px;
      border-radius: 3px;
      margin-left: 6px;
    }

    .test-panel button {
      background: #222;
      color: var(--text-white);
      border: 1px solid var(--secondary-color);
      padding: 5px 8px;
      margin: 2px;
      border-radius: 5px;
      cursor: pointer;
      font-size: 11px;
      font-weight: bold;
    }

    .test-panel button:hover {
      background: var(--secondary-color);
      color: black;
    }

    .panel-section {
      margin-top: 8px;
      border-top: 1px solid #444;
      padding-top: 6px;
    }

    .sound-status {
      margin-top: 8px;
      font-size: 10px;
      color: #aaa;
    }

    /* ⏱️ WIDGET 1: COMPACT COUNTDOWN TIMER */
    .countdown-widget {
      position: absolute;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      white-space: nowrap;
      pointer-events: none;
      transition: all 0.5s ease-in-out;
      z-index: 1000;
    }

    .countdown-label {
      font-size: 12px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--primary-color); 
      text-transform: uppercase;
      margin-bottom: 12px;
      text-shadow: 0 2px 4px var(--shadow-dark);
      transition: all 0.5s ease-in-out;
    }

    .countdown-timer {
      font-size: 34px;
      line-height: 1;
      font-weight: 900;
      letter-spacing: 1px;
      color: var(--text-white); 
      font-variant-numeric: tabular-nums;
      text-shadow: 0 2px 6px var(--shadow-dark);
      transition: all 0.5s ease-in-out;
    }

    .sep-dot {
      color: var(--primary-color);
      margin: 0 3px;
    }

    /* 🔥 FINAL 60 SECONDS STATE */
    .countdown-widget.final-minute .countdown-label {
      font-size: 16px;
      color: var(--primary-color);
      letter-spacing: 3px;
      margin-bottom: 12px;
      text-shadow: 0 0 8px rgba(172, 230, 0, 0.5);
      animation: finalSecondPulse 1s infinite alternate;
    }

    .countdown-widget.final-minute .countdown-timer {
      font-size: 48px;
      color: var(--text-white);
      text-shadow: 0 2px 8px var(--shadow-dark);
    }

    @keyframes finalSecondPulse {
      0% { transform: scale(1); }
      100% { transform: scale(1.05); }
    }

    .timer-finished .countdown-label {
      color: var(--primary-color);
      font-size: 24px;
      animation: pulseGlow 1.5s infinite alternate;
    }

    .timer-finished .countdown-timer {
      display: none !important;
    }

    @keyframes pulseGlow {
      0% { text-shadow: 0 0 6px rgba(172, 230, 0, 0.4); }
      100% { text-shadow: 0 0 12px rgba(172, 230, 0, 0.7); }
    }

    /* 💰 WIDGET 3: TOTAL RAISED GOAL COUNTER */
    .goal-widget {
      position: absolute;
      top: 88px; 
      left: 50%;
      transform: translateX(-50%);
      background: transparent;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 1px;
      white-space: nowrap;
      z-index: 1000;
      font-size: 22px;
      font-weight: 900;
      color: var(--text-white);
      text-shadow: 0 2px 8px var(--shadow-dark);
      transition: top 0.5s ease-in-out, opacity 0.4s ease-in-out;
    }

    body.is-final-minute .goal-widget {
      top: 106px;
    }

    .goal-label {
      font-size: 12px;
      line-height: 1;
      color: var(--text-white);
      display: block;
      margin-bottom: 8px;
      letter-spacing: 1.5px;
      text-shadow: 0 2px 4px var(--shadow-dark);
    }

    .amount {
      color: var(--primary-color);
      font-size: 34px;
      line-height: 1;
      font-weight: 900;
      text-shadow: 0 2px 8px var(--shadow-dark);
      transition: opacity 0.4s ease-in-out;
      display: block;
    }

    .goal-target {
      font-size: 11px;
      font-weight: 800;
      color: var(--text-white);
      display: block;
      margin-top: 8px;
      letter-spacing: 1.2px;
      opacity: 0.9;
      text-shadow: 0 2px 4px var(--shadow-dark);
    }

    /* 📢 WIDGET 2: DONATION ALERT BANNER */
    .alert-banner {
      position: absolute;
      top: 42%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0;
      visibility: hidden;
      text-align: center;
      background: transparent;
      padding: 10px;
      text-transform: uppercase;
      white-space: nowrap;
      pointer-events: none;
      z-index: 99999;
      transition: opacity 0.4s ease, visibility 0.4s ease;
      text-shadow: 0 3px 12px var(--shadow-dark);
    }

    .donor-name {
      color: var(--primary-color);
      display: block;
      font-size: 56px;
      font-weight: 900;
      margin-bottom: 5px;
      text-shadow: 0 0 8px rgba(172, 230, 0, 0.4);
    }

    .alert-subtext {
      color: var(--text-white);
      font-size: 38px;
      font-weight: 900;
    }

    .show-alert {
      opacity: 1 !important;
      visibility: visible !important;
      animation: elasticPop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    @keyframes elasticPop {
      0% { opacity: 0; transform: translate(-50%, -50%) scale(0.3); }
      60% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
      100% { opacity: 1; transform: translate(-50%, -50%) scale(1.0); }
    }

    /* 🎁 WIDGET 6: TRANSPARENT VERTICAL GIVEAWAY REEL WITH UNDER-TITLE COUNTDOWN BADGE */
    .giveaway-widget {
      position: absolute;
      top: 46%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 600px;
      height: 360px;
      background: transparent;
      border: none;
      box-shadow: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 99990;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.5s ease, visibility 0.5s ease;
      overflow: hidden;
    }

    .giveaway-widget.show {
      opacity: 1;
      visibility: visible;
    }

    /* Header Container */
    .giveaway-title-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-top: 4px;
      margin-bottom: 18px;
    }

    .giveaway-head-title {
      font-size: 20px;
      font-weight: 900;
      letter-spacing: 2.5px;
      color: var(--primary-color);
      text-transform: uppercase;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.95);
    }

    .giveaway-sub-title {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.5px;
      color: var(--text-white);
      opacity: 0.85;
      text-transform: uppercase;
      margin-top: 4px;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.95);
    }

    /* Start Countdown Badge Positioned Directly Under the Sub-Title */
    .giveaway-timer-badge {
      display: inline-block;
      margin-top: 8px;
      background: rgba(172, 230, 0, 0.15);
      border: 1px solid var(--primary-color);
      color: var(--primary-color);
      font-size: 11px;
      font-weight: 900;
      padding: 3px 10px;
      border-radius: 5px;
      letter-spacing: 1px;
      font-variant-numeric: tabular-nums;
      text-shadow: 0 0 6px rgba(172, 230, 0, 0.5);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
      white-space: nowrap;
      text-transform: uppercase;
    }

    .reel-viewport {
      position: relative;
      width: 100%;
      height: 215px; /* 5 visible items @ 43px each */
      overflow: hidden;
    }

    /* Green Indicator Line Fade */
    .reel-viewport::before, .reel-viewport::after {
      content: '';
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 270px; 
      height: 2px;
      background: linear-gradient(90deg, transparent 0%, var(--primary-color) 20px, var(--primary-color) calc(100% - 20px), transparent 100%);
      box-shadow: 0 0 5px rgba(172, 230, 0, 0.5);
      z-index: 10;
      pointer-events: none;
    }

    .reel-viewport::before { top: 86px; }  
    .reel-viewport::after  { top: 129px; } 

    .reel-track {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      will-change: transform;
    }

    .reel-item {
      height: 43px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      text-transform: uppercase;
      white-space: nowrap;
      will-change: opacity, font-size, color;
    }

    /* 🖼️ WIDGET 4: SPONSORSHIP LOGO ROTATOR */
    .sponsor-widget {
      position: absolute;
      bottom: 85px;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      z-index: 1000;
      background: transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .sponsor-logo-container {
      width: 140px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .sponsor-logo {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      transition: opacity 0.6s ease-in-out;
      opacity: 1;
      filter: drop-shadow(0 2px 5px var(--shadow-dark));
    }

    .sponsor-label {
      font-size: 11px;
      font-weight: 900;
      color: var(--primary-color);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      display: block;
      margin-top: 4px;
      text-shadow: 0 2px 5px var(--shadow-dark);
    }

    /* 📅 WIDGET 5: TIMELINE BAR */
    .schedule-widget {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      width: 96vw;
      background: transparent;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: 1000;
      pointer-events: none;
    }

    .timeline-container {
      position: relative;
      width: 100%;
    }

    .timeline-line-bg {
      position: absolute;
      top: 50%;
      left: 0;
      width: 100%;
      height: 2px;
      background: rgba(255, 255, 255, 0.25);
      transform: translateY(-50%);
      z-index: 1;
    }

    .timeline-line-fill {
      position: absolute;
      top: 50%;
      left: 0;
      height: 3px;
      background: var(--primary-color);
      box-shadow: 0 0 6px rgba(172, 230, 0, 0.5);
      transform: translateY(-50%);
      z-index: 2;
      width: 0%;
      transition: width 0.5s linear;
    }

    .timeline-cursor {
      position: absolute;
      top: 50%;
      left: 0%;
      width: 10px;
      height: 10px;
      background: var(--primary-color);
      box-shadow: 0 0 6px var(--primary-color);
      transform: translate(-50%, -50%);
      z-index: 5;
      border-radius: 50%;
      transition: left 0.5s linear;
    }

    .timeline-cursor::after {
      content: '';
      position: absolute;
      top: -4px;
      left: -4px;
      right: -4px;
      bottom: -4px;
      border: 1.5px solid var(--primary-color);
      border-radius: 50%;
      animation: cursorSonar 1.8s infinite ease-out;
    }

    @keyframes cursorSonar {
      0% { transform: scale(0.5); opacity: 0.8; }
      100% { transform: scale(1.8); opacity: 0; }
    }

    .timeline-nodes-row {
      position: relative;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      z-index: 3;
    }

    .timeline-day-badge {
      background: rgba(172, 230, 0, 0.12);
      border: 1px solid rgba(172, 230, 0, 0.6);
      backdrop-filter: blur(4px);
      color: var(--primary-color);
      font-size: 10px;
      font-weight: 900;
      padding: 2px 7px;
      border-radius: 4px;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      white-space: nowrap;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);
      margin-right: 12px;
      align-self: center;
    }

    .timeline-node {
      display: flex;
      flex-direction: column;
      position: relative;
      flex: 1;
      align-items: center;
      text-align: center;
      padding: 0 2px;
      transition: all 0.3s ease;
      text-shadow: 0 2px 6px var(--shadow-dark);
    }

    .node-time {
      height: 22px;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      font-size: 11px;
      font-weight: 800;
      color: #e0e0e0;
      letter-spacing: 0.6px;
      white-space: nowrap;
    }

    .node-tick-wrapper {
      position: relative;
      width: 100%;
      height: 16px;
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }

    .node-divider-tick {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 2px;
      height: 12px;
      background: rgba(255, 255, 255, 0.4);
      border-radius: 1px;
      transition: all 0.3s ease;
      z-index: 4;
    }

    .timeline-node.last-node .node-tick-wrapper::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 2px;
      height: 12px;
      background: rgba(255, 255, 255, 0.4);
      border-radius: 1px;
      transition: all 0.3s ease;
      z-index: 4;
    }

    .node-streamer {
      height: 22px;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      font-size: 14px;
      font-weight: 900;
      color: var(--text-white);
      white-space: nowrap;
      letter-spacing: 0.3px;
    }

    .node-streamer.is-giveaway-text {
      color: var(--giveaway-color);
    }

    .timeline-node.active .node-divider-tick {
      background: var(--primary-color);
      height: 16px;
      width: 3px;
      box-shadow: 0 0 6px rgba(172, 230, 0, 0.6);
    }

    .timeline-node.active .node-streamer {
      font-size: 17px;
      font-weight: 900;
      color: var(--primary-color);
      text-shadow: 0 0 8px rgba(172, 230, 0, 0.5);
    }

    .timeline-node.active .node-streamer.is-giveaway-text {
      color: var(--giveaway-color);
      font-size: 17px;
      text-shadow: 0 0 8px rgba(255, 234, 0, 0.6);
    }

    .timeline-node.active .node-time {
      color: var(--text-white);
      font-size: 12px;
      font-weight: 900;
    }

    .brb-header {
      position: absolute;
      top: 35%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 64px;
      font-weight: 900;
      color: var(--primary-color);
      text-transform: uppercase;
      text-shadow: 0 0 15px rgba(172, 230, 0, 0.5);
      display: none;
      z-index: 1000;
    }
  </style>
</head>
<body>

  <!-- 🎛️ TEST CONTROL PANEL (v2.7) -->
  <div class="test-panel" id="testPanel">
    <h4 id="panelDragHeader">🧪 TESTPANEL <span class="version-badge">v2.7</span> <span style="font-size:10px; opacity:0.8;">✋ DRA FÖR ATT FLYTTA</span></h4>
    
    <div class="panel-section">
      <b>🎁 Giveaway Hjul Controls (Max 5 Biljetter / Givare):</b><br>
      <div id="giveawayStats" style="font-size:11px; color:#ace600; margin:4px 0;">Biljetter: 0 | Givare: 0</div>
      <button onclick="startGiveawaySpin()" style="background:#ace600; color:#000;">🎯 Dra Vinnare (Köläggs)</button>
      <button onclick="skipWinner()" style="background:#ffea00; color:#000;">⏭️ Hoppa Över (Skip)</button>
      <button onclick="claimAndDeleteTicket()" style="background:#ff0055; color:#fff;">✅ Ta Emot & Radera Biljett</button>
      <button onclick="loadFiftyTestNames()" style="background:#00ff88; color:#000;">🎲 Ladda 50+ Testnamn</button>
    </div>

    <div class="panel-section">
      <b>Test Donationer:</b><br>
      <button onclick="simulateDonation('Lisa', 250)">+250 kr (Lisa - 1 B)</button>
      <button onclick="simulateDonation('Lisa', 800)">+800 kr (Lisa = Max 5 B)</button>
      <button onclick="simulateDonation('Erik', 600)">+600 kr (Erik - 3 B)</button>
      <button onclick="simulateDonation('Anonym', 500)">+500 kr (Anonym - 0 B)</button>
      <button onclick="resetTotal()" style="border-color:#ff0055;">Nollställ Doneringar</button>
    </div>

    <div class="panel-section">
      <b>Live Schema Test:</b><br>
      <button onclick="generateRelativeLiveEvents()" style="background:#ace600; color:#000;">⚡ Generera Relativa Events (Nu)</button>
    </div>
    
    <div class="panel-section">
      <b>Timer kontroller:</b><br>
      <button onclick="simulateEndGame()">Sista Minuten (60s)</button>
      <button onclick="resetEventTimer()">Återställ Timer</button>
    </div>

    <div class="panel-section">
      <b>Sponsor kontroller:</b><br>
      <button onclick="nextSponsor()">Nästa Sponsor</button>
    </div>

    <div class="sound-status" id="soundStatus">Laddar...</div>
  </div>

  <!-- ⏱️ WIDGET 1: COUNTDOWN TIMER -->
  <div class="countdown-widget" id="countdownWidget">
    <div class="countdown-label" id="countdownLabel">INSAMLINGEN SLUTAR OM</div>
    <div class="countdown-timer" id="countdownTimer">0D • 00:00:00</div>
  </div>

  <!-- 💰 WIDGET 3: GOAL COUNTER -->
  <div class="goal-widget" id="goalWidget">
    <span class="goal-label">TOTALT INSAMLAT</span>
    <span class="amount" id="totalDisplay">0 kr</span>
    <span class="goal-target">MÅL: 40 000 KR</span>
  </div>

  <!-- 📢 WIDGET 2: DONATION ALERT -->
  <div class="alert-banner" id="alertBanner">
    <span class="donor-name" id="donorName">JOHAN</span> 
    <div class="alert-subtext">DONERADE <span id="alertAmount">50 kr</span>!</div>
  </div>

  <!-- 🎁 WIDGET 6: TRANSPARENT VERTICAL GIVEAWAY REEL (WITH UNDER-TITLE COUNTDOWN BADGE) -->
  <div class="giveaway-widget" id="giveawayWidget">
    <div class="giveaway-title-container">
      <div class="giveaway-head-title">🎁 GIVEAWAY</div>
      <div class="giveaway-sub-title" id="giveawaySubTitle">TOTALT 0 TICKETS</div>
      <div class="giveaway-timer-badge" id="giveawayHeaderTimer">STARTAR OM 10S</div>
    </div>
    <div class="reel-viewport">
      <div class="reel-track" id="reelTrack"></div>
    </div>
  </div>

  <!-- 🖼️ WIDGET 4: SPONSOR ROTATOR -->
  <div class="sponsor-widget" id="sponsorWidget">
    <div class="sponsor-logo-container">
      <img id="sponsorLogo" class="sponsor-logo" src="" alt="Sponsor Logo" />
    </div>
    <span class="sponsor-label">SPONSORER</span>
  </div>

  <!-- 📅 WIDGET 5: SCHEDULE BAR -->
  <div class="schedule-widget" id="scheduleWidget">
    <div class="timeline-container">
      <div class="timeline-line-bg"></div>
      <div class="timeline-line-fill" id="timelineProgressFill"></div>
      <div class="timeline-cursor" id="timelineCursor"></div>
      
      <div class="timeline-nodes-row" id="scheduleEventsRow"></div>
    </div>
  </div>

  <!-- BRB Header Text -->
  <div class="brb-header" id="brbHeader">STRAX TILLBAKA</div>

  <script>
    // =========================================================
    // CONFIGURATION & BÖSSA API CONNECTIONS
    // =========================================================
    const FUNDRAISER_SLUG = "our2ndHome";
    const FUNDRAISER_URL = `https://bossan.musikhjalpen.se/${FUNDRAISER_SLUG}`;
    const CHECK_INTERVAL_SECONDS = 5;
    const TICKET_MILESTONE_KR = 200; // 200 kr = 1 Ticket
    const MAX_TICKETS_PER_USER = 5;  // Max 5 tickets per unique donor

    const GITHUB_USERNAME = "Our2ndHome";
    const GITHUB_REPO = "index";
    const SOUNDS_FOLDER = "sounds"; 
    const SPONSORS_FOLDER = "sponsors";
    const SOUND_VOLUME = 0.8;
    const SPONSOR_ROTATE_SECONDS = 15;
    const PAUSE_BETWEEN_ALERTS_SECONDS = 5; 

    // BACKUP SOUNDS
    const TIKTOK_BACKUP_SOUNDS = [
      'sounds/ssstik.io_1786298964532.mp3',
      'sounds/ssstik.io_1786298991426.mp3',
      'sounds/ssstik.io_1786299005161.mp3'
    ];

    // BACKUP SPONSORS
    const DEFAULT_SPONSORS = [
