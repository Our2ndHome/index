    // =========================================================
    // 📅 SCHEDULE TIMELINE ENGINE
    // =========================================================
    function renderSchedule() {
      const eventsRowEl = document.getElementById('scheduleEventsRow');
      const fillLineEl = document.getElementById('timelineProgressFill');
      const cursorEl = document.getElementById('timelineCursor');
      if (!eventsRowEl) return;

      const now = new Date();
      let activeIndex = 0;

      if (testForcedEventId !== -1) {
        const found = ALL_SCHEDULE_EVENTS.findIndex(ev => ev.id === testForcedEventId);
        if (found !== -1) activeIndex = found;
      } else {
        const found = ALL_SCHEDULE_EVENTS.findIndex(ev => {
          return now >= new Date(ev.start) && now < new Date(ev.end);
        });
        if (found !== -1) {
          activeIndex = found;
        } else {
          const upcoming = ALL_SCHEDULE_EVENTS.findIndex(ev => new Date(ev.start) > now);
          if (upcoming !== -1) activeIndex = upcoming;
        }
      }

      let visibleEvents = ALL_SCHEDULE_EVENTS.slice(activeIndex, activeIndex + 5);
      if (visibleEvents.length < 5 && ALL_SCHEDULE_EVENTS.length >= 5) {
        visibleEvents = ALL_SCHEDULE_EVENTS.slice(ALL_SCHEDULE_EVENTS.length - 5);
      }

      const totalVisible = visibleEvents.length;

      if (totalVisible > 0) {
        let activeLocalIdx = visibleEvents.findIndex(ev => ev.id === (testForcedEventId !== -1 ? testForcedEventId : ALL_SCHEDULE_EVENTS[activeIndex].id));
        if (activeLocalIdx === -1) activeLocalIdx = 0;

        const currentEv = visibleEvents[activeLocalIdx];
        const startMs = new Date(currentEv.start).getTime();
        const endMs = new Date(currentEv.end).getTime();
        const nowMs = now.getTime();

        let currentSlotPct = 0;
        if (testForcedEventId !== -1 || nowMs >= endMs) {
          currentSlotPct = 1.0;
        } else if (nowMs > startMs) {
          currentSlotPct = (nowMs - startMs) / (endMs - startMs);
        }

        const slotWidthPct = 100 / totalVisible;
        const totalProgressPct = Math.min(100, Math.max(0, (activeLocalIdx + currentSlotPct) * slotWidthPct));

        if (fillLineEl) fillLineEl.style.width = `${totalProgressPct}%`;
        if (cursorEl) cursorEl.style.left = `${totalProgressPct}%`;
      }

      const currentActiveDay = visibleEvents[0] ? visibleEvents[0].dayName : "";
      let lastSeenDay = currentActiveDay;

      eventsRowEl.innerHTML = visibleEvents.map((ev, index) => {
        const isLiveNow = (testForcedEventId === ev.id) || 
                          (testForcedEventId === -1 && now >= new Date(ev.start) && now < new Date(ev.end));

        const hasGiveaway = Boolean(ev.giveaway && ev.giveaway.trim());
        const primaryText = escapeHTML(hasGiveaway ? ev.giveaway : ev.name);
        const streamerClass = hasGiveaway ? "node-streamer is-giveaway-text" : "node-streamer";

        let dayBadgeHtml = "";
        if (ev.dayName !== currentActiveDay && ev.dayName !== lastSeenDay) {
          dayBadgeHtml = `<div class="timeline-day-badge">${escapeHTML(ev.dayName)}</div>`;
          lastSeenDay = ev.dayName;
        }

        const isLastNode = (index === totalVisible - 1);

        return `
          ${dayBadgeHtml}
          <div class="timeline-node ${isLastNode ? 'last-node' : ''} ${isLiveNow ? 'active' : 'inactive'}">
            <div class="node-time">${escapeHTML(ev.timeText)}</div>
            <div class="node-tick-wrapper">
              <div class="node-divider-tick"></div>
            </div>
            <div class="${streamerClass}">${primaryText}</div>
          </div>
        `;
      }).join('');
    }

