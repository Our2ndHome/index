    function recordDonorDonation(donorName, donationAmount) {
      if (!donorName || !donorName.trim()) return;

      const cleanName = donorName.trim();

      // Exclude Anonymous Donors from giveaway tickets
      if (/anonym/i.test(cleanName)) return;

      if (!donorTicketsMap[cleanName]) {
        donorTicketsMap[cleanName] = { totalAmount: 0, ticketsEarned: 0, ticketsActive: 0 };
      }

      const donorObj = donorTicketsMap[cleanName];
      donorObj.totalAmount += donationAmount;

      // 200 kr = 1 Ticket (Capped at MAX 5 Tickets per donor)
      const rawCalculatedTickets = Math.floor(donorObj.totalAmount / TICKET_MILESTONE_KR);
      const cappedTotalTickets = Math.min(MAX_TICKETS_PER_USER, rawCalculatedTickets);

      const addedTickets = cappedTotalTickets - donorObj.ticketsEarned;

      if (addedTickets > 0) {
        donorObj.ticketsEarned += addedTickets;
        donorObj.ticketsActive += addedTickets;
      }

      updateGiveawayStatsUI();
    }

