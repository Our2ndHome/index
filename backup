    function executeReelSpinAnimation(holdDelayMs = 10000) {
      const ticketPool = getActiveTicketPool();
      if (ticketPool.length === 0) return;

      if (giveawayHoldTimeout) clearTimeout(giveawayHoldTimeout);
      if (headerCountdownInterval) clearInterval(headerCountdownInterval);

      isSpinningReel = true;
      const reelTrack = document.getElementById('reelTrack');
      const timerBadgeEl = document.getElementById('giveawayHeaderTimer');

      // Pick random winning ticket entry
      const winningTicketIndex = Math.floor(Math.random() * ticketPool.length);
      const winnerName = ticketPool[winningTicketIndex];
      currentDrawnWinner = winnerName;

      // Check if this is a fresh open vs continuous skip roll
      const isFreshOpen = (reelTrack.children.length === 0 || holdDelayMs > 2000);
      const itemHeight = 43; // 43px item height

      if (isFreshOpen) {
        // Fresh Open: Render initial 28 items starting at Y=0
        const spinList = [];
        for (let i = 0; i < 25; i++) {
          spinList.push(ticketPool[Math.floor(Math.random() * ticketPool.length)]);
        }
        spinList.push(winnerName);
        spinList.push(ticketPool[Math.floor(Math.random() * ticketPool.length)]);
        spinList.push(ticketPool[Math.floor(Math.random() * ticketPool.length)]);

        reelTrack.style.transition = 'none';
        reelTrack.style.transform = 'translateY(0px)';
        reelTrack.innerHTML = spinList.map((name) => `<div class="reel-item">${escapeHTML(name)}</div>`).join('');

        // Initial static opacities during the 10-second hold
        const initialItems = reelTrack.children;
        for (let i = 0; i < Math.min(5, initialItems.length); i++) {
          if (i === 2) {
            initialItems[i].style.opacity = '1.0';
            initialItems[i].style.fontSize = '30px';
            initialItems[i].style.fontWeight = '900';
            initialItems[i].style.color = '#ffffff';
            initialItems[i].style.textShadow = '0 2px 8px rgba(0,0,0,0.9)';
          } else if (i === 1 || i === 3) {
            initialItems[i].style.opacity = '0.6';
            initialItems[i].style.fontSize = '22px';
            initialItems[i].style.fontWeight = '800';
            initialItems[i].style.color = '#ffffff';
            initialItems[i].style.textShadow = '0 2px 6px rgba(0,0,0,0.9)';
          } else {
            initialItems[i].style.opacity = '0.2';
            initialItems[i].style.fontSize = '16px';
            initialItems[i].style.color = '#ffffff';
            initialItems[i].style.textShadow = 'none';
          }
        }
      } else {
        // Continuous Skip Roll: Append 25 new items to current DOM without resetting Y position!
        const additionalList = [];
        for (let i = 0; i < 25; i++) {
          additionalList.push(ticketPool[Math.floor(Math.random() * ticketPool.length)]);
        }
        additionalList.push(winnerName);
        additionalList.push(ticketPool[Math.floor(Math.random() * ticketPool.length)]);
        additionalList.push(ticketPool[Math.floor(Math.random() * ticketPool.length)]);

        const additionalHtml = additionalList.map((name) => `<div class="reel-item">${escapeHTML(name)}</div>`).join('');
        reelTrack.insertAdjacentHTML('beforeend', additionalHtml);
      }

      // Calculate Target Translate Y
      const totalItems = reelTrack.children.length;
      const targetIndex = totalItems - 3;
      const targetTranslateY = -(targetIndex - 2) * itemHeight;

      // Start 10-Second Hold Countdown (Displayed under title)
      const holdSeconds = Math.round(holdDelayMs / 1000);
      startHeaderCountdownTimer(holdSeconds, "STARTAR OM ");

      // Frame-by-frame Computed WebKit Matrix Position Reader
      function updateOpacities() {
        let currentY = 0;
        try {
          const matrix = new WebKitCSSMatrix(window.getComputedStyle(reelTrack).transform);
          currentY = Math.abs(matrix.m42); 
        } catch (e) {
          const transformMatch = reelTrack.style.transform.match(/translateY\(([^px]+)px\)/);
          currentY = transformMatch ? Math.abs(parseFloat(transformMatch[1])) : 0;
        }

        const centerIndexFloat = (currentY / itemHeight) + 2;
        const items = reelTrack.children;

        for (let i = 0; i < items.length; i++) {
          const dist = Math.abs(i - centerIndexFloat);

          if (dist <= 2.2) {
            const opacity = Math.max(0.2, 1 - (dist * 0.4)); 
            const fontSize = Math.max(16, 30 - (dist * 6));
            
            items[i].style.opacity = opacity;
            items[i].style.fontSize = `${fontSize}px`;
            items[i].style.color = '#ffffff'; 

            if (dist < 0.35) {
              items[i].style.textShadow = '0 2px 8px rgba(0,0,0,0.9)';
              items[i].style.fontWeight = '900';
            } else {
              items[i].style.textShadow = '0 2px 6px rgba(0,0,0,0.9)';
              items[i].style.fontWeight = '800';
            }
          } else {
            items[i].style.opacity = '0.1';
            items[i].style.fontSize = '14px';
            items[i].style.color = '#ffffff';
          }
        }

        if (isSpinningReel) {
          reelAnimationTimer = requestAnimationFrame(updateOpacities);
        }
      }

      // ⏱️ Hold Static BEFORE Starting Downward Spin
      giveawayHoldTimeout = setTimeout(() => {
        if (!document.getElementById('giveawayWidget').classList.contains('show')) return;

        // Hide Start Countdown Badge as soon as spin begins!
        if (headerCountdownInterval) clearInterval(headerCountdownInterval);
        if (timerBadgeEl) timerBadgeEl.style.display = 'none';

        reelTrack.style.transition = 'transform 12s cubic-bezier(0.1, 0.75, 0.25, 1)';
        reelTrack.style.transform = `translateY(${targetTranslateY}px)`;
        reelAnimationTimer = requestAnimationFrame(updateOpacities);

        // Finish Spin after 12 seconds: REVEAL #ace600 WINNER COLOR ON DEAD STOP!
        setTimeout(() => {
          isSpinningReel = false;
          cancelAnimationFrame(reelAnimationTimer);

          // Snap final winner styling in Lime Green (#ace600)!
          const items = reelTrack.children;
          for (let i = 0; i < items.length; i++) {
            const dist = Math.abs(i - targetIndex);
            if (dist === 0) {
              items[i].style.opacity = '1.0';
              items[i].style.fontSize = '32px';
              items[i].style.fontWeight = '900';
              items[i].style.color = '#ace600';
              items[i].style.textShadow = '0 0 10px rgba(172, 230, 0, 0.6), 0 2px 8px rgba(0,0,0,0.9)';
            } else if (dist === 1) {
              items[i].style.opacity = '0.6';
              items[i].style.fontSize = '22px';
              items[i].style.fontWeight = '800';
              items[i].style.color = '#ffffff';
              items[i].style.textShadow = '0 2px 6px rgba(0,0,0,0.9)';
            } else {
              items[i].style.opacity = '0.2';
              items[i].style.fontSize = '16px';
              items[i].style.color = '#ffffff';
              items[i].style.textShadow = 'none';
            }
          }
        }, 12100);

      }, holdDelayMs);
    }

